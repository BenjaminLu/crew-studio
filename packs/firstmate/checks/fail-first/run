#!/usr/bin/env node
const fs = require("fs"), path = require("path"), { spawnSync } = require("child_process");
let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => {
  const i = JSON.parse(s); const cfg = i.repo_cfg ?? {}; const b = i.base_tree ?? {};
  const out = (verdict, findings, extra = {}) => process.stdout.write(JSON.stringify({ verdict, score: verdict === "pass" ? 1 : 0, findings, evidence: ["out/base.log", "out/head.log"].filter((e) => fs.existsSync(path.join(i.out, e.slice(4)))), proves: [], ...extra }));
  if (!b.applicable) return out("pass", [], { data: { applicable: false, why: "no behaviour file changed" } });
  if (!b.tests?.length) return out("fail", b.behaviour.map((p) => ({ locator: { type: "file", path: p }, message: `${p} changed with no test change`, expected: "add or change a test that fails without this change", class: "failfirst-no-test", severity: "blocking" })));
  if (!cfg.test) return out("fail", [{ locator: { type: "file", path: ".crew/gates.json" }, message: "no test command", expected: "declare test", class: "ci-config", severity: "blocking" }]);
  const run = (dir) => { const r = spawnSync(cfg.test[0], cfg.test.slice(1), { cwd: dir, env: { ...process.env, CREW_SHARD: "0", CREW_SHARDS: "1" }, encoding: "utf8", timeout: 280000 }); return { code: r.status, log: (r.stdout ?? "") + (r.stderr ?? "") }; };
  const base = run(b.path), head = run(i.workdir);
  fs.writeFileSync(path.join(i.out, "base.log"), base.log); fs.writeFileSync(path.join(i.out, "head.log"), head.log);
  const red = base.log.split("\n").filter((l) => /^FAIL\b/.test(l));
  const f = [];
  if (head.code !== 0) f.push({ locator: { type: "file", path: b.tests[0] }, message: `the tests fail on the head too: ${head.log.trim().split("\n").filter((l) => /FAIL/.test(l)).slice(0, 2).join(" | ").slice(0, 300)}`, expected: "green on the head", class: "failfirst-head-red", severity: "blocking" });
  if (base.code === 0) f.push({ locator: { type: "file", path: b.tests[0] }, message: `nothing went red on the base: ${b.tests.join(", ")} pass without the change, so they do not test it`, expected: "a test that fails on the base behaviour", class: "failfirst-not-red", severity: "blocking" });
  const proves = []; if (!f.length) (i.spec?.done ?? []).forEach((d, k) => { const m = /(tests?\/[\w./-]+|[\w./-]+\.test\.\w+)/.exec(d); if (m && red.some((l) => l.includes(path.basename(m[1])))) proves.push(k); });
  out(f.length ? "fail" : "pass", f, { proves, data: { applicable: true, red: red.slice(0, 20) } });
});
