#!/usr/bin/env node
// covering-suites: the test files that import a changed file (or changed themselves) run with CREW_TEST_FILES.
const fs = require("fs"), path = require("path"), { spawnSync } = require("child_process");
let s = ""; process.stdin.on("data", (d) => (s += d)).on("end", () => {
  const i = JSON.parse(s); const root = i.workdir; const cfg = i.repo_cfg ?? {}; const out = (v, f = []) => process.stdout.write(JSON.stringify({ verdict: v, score: v === "pass" ? 1 : 0, findings: f, evidence: ["out/covering.log"], proves: [] }));
  if (!cfg.test) return out("skip");
  const isTest = (p) => (cfg.tests ?? ["tests/**"]).some((g) => p.startsWith(g.replace(/\*\*.*$/, "")) || /\.test\./.test(p));
  const changed = (i.diff?.paths ?? []).filter((c) => !String(c.status).startsWith("D")).map((c) => c.path);
  const tests = new Set(changed.filter(isTest));
  const all = []; const walk = (d) => { for (const n of fs.readdirSync(d)) { if (n === ".git" || n === "node_modules") continue; const p = path.join(d, n); if (fs.statSync(p).isDirectory()) walk(p); else all.push(path.relative(root, p)); } }; walk(root);
  for (const t of all.filter(isTest)) { const txt = fs.readFileSync(path.join(root, t), "utf8"); for (const c of changed) if (!isTest(c) && txt.includes(path.basename(c).replace(/\.[^.]+$/, ""))) tests.add(t); }
  if (!tests.size) return out("pass");
  const r = spawnSync(cfg.test[0], cfg.test.slice(1), { cwd: root, env: { ...process.env, CREW_TEST_FILES: [...tests].map((t) => path.basename(t)).join(",") }, encoding: "utf8", timeout: 200000 });
  const log = (r.stdout ?? "") + (r.stderr ?? ""); fs.writeFileSync(path.join(i.out, "covering.log"), log);
  const f = log.split("\n").filter((l) => /^FAIL\b/.test(l)).slice(0, 20).map((l) => { const m = /^FAIL\s+([^:]+):\s*(.*)$/.exec(l); return { locator: { type: "file", path: m ? `tests/${m[1]}` : [...tests][0] }, message: l.slice(0, 300), expected: "the covering test passes", class: "covering-test-fails", severity: "blocking" }; });
  if (r.status !== 0 && !f.length) f.push({ locator: { type: "file", path: [...tests][0] }, message: log.trim().split("\n").slice(-3).join(" | ").slice(0, 300), expected: "exit 0", class: "covering-test-fails", severity: "blocking" });
  out(r.status === 0 ? "pass" : "fail", f);
});
