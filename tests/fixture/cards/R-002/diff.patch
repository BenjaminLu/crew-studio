-/** "$12.34" from 1234. */
-export function format(amount: number): string {
+/** Currencies format() knows. USD amounts are in cents; JPY amounts are whole yen. */
+export type Currency = "USD" | "JPY";
+
+/** "$12.34" from 1234 (USD, the default); "¥1,234" from (1234, "JPY"). */
+export function format(amount: number, currency: Currency = "USD"): string {
   const sign = amount < 0 ? "-" : "";
   const abs = Math.abs(amount);
+  if (currency === "JPY") {
+    return `${sign}¥${String(abs).replace(/\B(?=(\d{3})+(?!\d))/g, ",")}`;
+  }
   return `${sign}$${Math.floor(abs / 100)}.${String(abs % 100).padStart(2, "0")}`;
 }
