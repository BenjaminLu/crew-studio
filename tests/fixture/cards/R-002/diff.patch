@@ -6,3 +6,21 @@ describe("format", () => {
   test("pads the cents", () => expect(format(105)).toBe("$1.05"));
   test("shows a minus sign", () => expect(format(-250)).toBe("-$2.50"));
 });
+
+describe("format with JPY", () => {
+  test("shows whole yen with a thousands separator", () => expect(format(1235, "JPY")).toBe("¥1,235"));
+  test("shows a minus sign and zero", () => {
+    expect(format(-1235, "JPY")).toBe("-¥1,235");
+    expect(format(0, "JPY")).toBe("¥0");
+  });
+  test("groups JPY thousands but leaves USD ungrouped", () => {
+    expect(format(123456, "JPY")).toBe("¥123,456");
+    expect(format(123456)).toBe("$1234.56");
+    expect(format(123456, "USD")).toBe("$1234.56");
+  });
+  test("USD matches the default while JPY differs", () => {
+    expect(format(1999, "JPY")).toBe("¥1,999");
+    expect(format(1999, "USD")).toBe("$19.99");
+    expect(format(1999, "USD")).toBe(format(1999));
+  });
+});
