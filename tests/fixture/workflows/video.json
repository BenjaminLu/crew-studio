{
  "id": "video",
  "name": "Video",
  "description": "Intent → film from the template → render → timeline review loop (editor revises, re-render) → approve → Library.",
  "roles": [
    {
      "id": "editor",
      "label": "Film editor",
      "skill": "bundled:workflows/skills/v2/designer.md"
    }
  ],
  "nodes": [
    {
      "id": "intake",
      "kind": "hook",
      "label": "Capture intent",
      "do": "intent.capture",
      "x": 170,
      "y": 120
    },
    {
      "id": "make",
      "kind": "hook",
      "label": "Film from template",
      "do": "film.create",
      "x": 340,
      "y": 120
    },
    {
      "id": "render",
      "kind": "hook",
      "label": "Render",
      "detail": "frames + ffmpeg",
      "do": "film.render",
      "timeout_s": 2700,
      "x": 510,
      "y": 120
    },
    {
      "id": "review",
      "kind": "card",
      "label": "Timeline review",
      "detail": "ranges → editor → re-render",
      "role": "editor",
      "args": {
        "mode": "review",
        "card_kind": "acceptance",
        "max_rounds": 5
      },
      "x": 680,
      "y": 120
    },
    {
      "id": "library",
      "kind": "hook",
      "label": "Library",
      "do": "library.publish",
      "x": 850,
      "y": 120
    },
    {
      "id": "done",
      "kind": "hook",
      "label": "Approved",
      "args": {
        "summary": "{{ctx.library.artifact}} v{{ctx.library.version}} approved"
      },
      "x": 1020,
      "y": 120
    },
    {
      "id": "rejected",
      "kind": "hook",
      "label": "Rejected",
      "args": {
        "result": "closed"
      },
      "x": 850,
      "y": 260
    }
  ],
  "edges": [
    {
      "from": "intake",
      "to": "make"
    },
    {
      "from": "make",
      "to": "render"
    },
    {
      "from": "render",
      "to": "review"
    },
    {
      "from": "review",
      "to": "library",
      "when": "approved"
    },
    {
      "from": "review",
      "to": "rejected",
      "when": "rejected|cap"
    },
    {
      "from": "library",
      "to": "done"
    }
  ],
  "version": 1
}
