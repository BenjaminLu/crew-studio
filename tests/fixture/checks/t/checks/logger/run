#!/usr/bin/env node
// passes once the flag file exists; until then it writes a test-runner style log with the failure in the middle
const fs=require("fs"),path=require("path");let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const i=JSON.parse(s);const ok=i.params.flagfile&&fs.existsSync(i.params.flagfile);
if(ok){process.stdout.write(JSON.stringify({verdict:"pass",score:1,findings:[],evidence:[],proves:[]}));return;}
const lines=["$ bun test","bun test v1.2.0","",...Array.from({length:30},(_,k)=>`(pass) case ${k}`),`env: GITHUB_TOKEN=${i.params.token}`,`  error: fixture download failed with token ${i.params.token}`,"(fail) totals add up [1.20ms]","  error: expect(received).toBe(expected)","  Expected: 42","  Received: 41","      at src/a.js:15:3",...Array.from({length:20},(_,k)=>`(pass) later ${k}`)," 50 pass"," 1 fail"];
fs.writeFileSync(path.join(i.out,"log.txt"),lines.join("\n")+"\n");
process.stdout.write(JSON.stringify({verdict:"fail",score:0,findings:[{locator:{type:"file",path:"src/a.js",line:15},message:"totals add up: expected 42, received 41",expected:"total() returns 42 for the sample cart",class:"wrong-total",severity:"blocking"}],evidence:["out/log.txt"],proves:[]}))});
