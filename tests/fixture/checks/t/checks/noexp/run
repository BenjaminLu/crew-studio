#!/usr/bin/env node
const fs=require("fs");let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const i=JSON.parse(s);const ok=i.params.flagfile&&fs.existsSync(i.params.flagfile);process.stdout.write(JSON.stringify(ok?{verdict:"pass",score:1,findings:[],evidence:[],proves:[]}:{verdict:"fail",score:0,findings:[{message:"vague problem",class:"vague",severity:"blocking"}],evidence:[],proves:[]}))});
